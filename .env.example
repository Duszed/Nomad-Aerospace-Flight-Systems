# Nomad Atlas settings. Copy to .env (never commit .env).
# Everything has a working default; the demo needs none of these.

# Where the database, flight logs, reports and signing key live.
ATLAS_DATA_DIR=data

# Database. Default is SQLite inside ATLAS_DATA_DIR.
# Postgres: install psycopg and use postgresql+psycopg://user:pass@host/atlas
# ATLAS_DB_URL=

# Public address of the verify server. This is what QR codes and share links point at.
ATLAS_BASE_URL=http://127.0.0.1:8000

# Telegram bot token from @BotFather. Needed for `python -m atlas bot`.
# ATLAS_BOT_TOKEN=

# How long a share link lives, in days.
ATLAS_SHARE_TTL_DAYS=30

# Laptop -> server sync. Set both on the laptop; set ATLAS_SYNC_TOKEN on the server.
# ATLAS_SERVER_URL=https://atlas.example.uz
# ATLAS_SYNC_TOKEN=
