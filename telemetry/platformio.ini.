; Nomad Aerospace - Field Telemetry Node Build Environment
; MCU: ESP32-C3 (RISC-V) - see SPECS.md
; ; root (no trailing characters) or PlatformIO will not detect it.

[env:esp32-c3-devkitm-1]
platform = espressif32
board = esp32-c3-devkitm-1
framework = arduino
monitor_speed = 115200

lib_deps =
    adafruit/Adafruit SHT4x Library @ ^1.0.4
    adafruit/Adafruit BusIO @ ^1.14.1
